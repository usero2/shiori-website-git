{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shiori-website-git",
  "compatibility_date": "2026-08-15",
  "observability": {
    "enabled": true
  },
  "assets": {
    // Site files live in the repo root. Everything listed in .assetsignore
    // (notably .git) is excluded from the upload.
    "directory": ".",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  }
}
